# Postgres (matches docker-compose.yml)
DATABASE_URL="postgresql://apidev:apidev@localhost:5432/apidev?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# HTTP
PORT=3000
PUBLIC_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:5173"

# Auth secrets — replace in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="dev-access-secret-change-me-dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# Rate limiting default (points per DEFAULT_RATE_LIMIT_WINDOW_SECONDS) for JWT-authenticated
# users that don't hold an API key. API keys use their own ApiKey.rateLimit column.
DEFAULT_RATE_LIMIT_POINTS=60
DEFAULT_RATE_LIMIT_WINDOW_SECONDS=60

# URL shortener
URL_SHORT_CODE_LENGTH=7

# PDF rendering
PDF_RENDER_TIMEOUT_MS=30000
PDF_MAX_CONCURRENT_RENDERS=2
PDF_MAX_QUEUED_RENDERS=10
PDF_QUEUE_TIMEOUT_MS=5000
PDF_HTML_MAX_BYTES=1048576
PDF_DEFAULT_FORMAT=A4
PDF_RATE_LIMIT_POINTS=10
PDF_RATE_LIMIT_WINDOW_SECONDS=60

# Tests use this isolated schema and Redis database by default. Override only
# when a dedicated test database/Redis instance is required by CI.
# TEST_DATABASE_URL="postgresql://apidev:apidev@localhost:5432/apidev?schema=api_dev_url_test"
# TEST_REDIS_URL="redis://localhost:6379/15"
