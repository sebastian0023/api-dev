{
  "name": "api-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx --test tests/unit/**/*.test.ts",
    "test:integration": "tsx scripts/runIntegrationTests.ts",
    "test:typecheck": "tsc -p tsconfig.test.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "openapi:dump": "tsx scripts/dumpOpenapi.ts",
    "web:generate": "web/node_modules/.bin/openapi-typescript openapi.json -o web/src/api/schema.d.ts",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "3.0.3",
    "cors": "2.8.5",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "ioredis": "6.0.0",
    "ipaddr.js": "2.3.0",
    "jsonwebtoken": "9.0.3",
    "path-to-regexp": "8.4.2",
    "pg": "8.16.3",
    "playwright": "1.62.0",
    "qrcode": "1.5.4",
    "rate-limiter-flexible": "11.2.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.4.3",
    "zod-openapi": "6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "@types/qrcode": "1.5.6",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "10.8.1",
    "prisma": "7.9.1",
    "tsx": "4.23.12",
    "typescript": "5.9.2",
    "typescript-eslint": "8.67.0"
  }
}
